{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PracticeOS Docs",
  "description": "Setup guides, everyday how-tos, and troubleshooting for Private Practice OS.",
  "colors": { "primary": "#554861", "light": "#C5AFD0", "dark": "#554861" },
  "favicon": "/favicon.svg",
  "logo": { "light": "/logo/light.svg", "dark": "/logo/dark.svg", "href": "/" },
  "fonts": { "family": "Nunito" },
  "background": { "color": { "light": "#FFFFFF", "dark": "#1C1523" } },
  "navigation": {
    "groups": [
      { "group": "Start here", "icon": "flag", "pages": ["index", "start-here/onboarding", "start-here/getting-help"] },
      { "group": "Set up your practice", "icon": "gear", "pages": ["setup/sign-in"] },
      { "group": "Connect your tools", "icon": "plug", "pages": ["integrations/email", "integrations/meta-facebook"] },
      { "group": "Calendar and appointments", "icon": "calendar", "pages": ["calendar/availability"] },
      { "group": "Communication", "icon": "message", "pages": ["communications/phone-sms", "communications/email-sending"] },
      { "group": "Website and growth", "icon": "globe", "pages": ["website-growth/website", "website-growth/marketing-integrations"] },
      { "group": "Administration", "icon": "wallet", "pages": ["administration/billing"] }
    ]
  },
  "navbar": {
    "primary": { "type": "button", "label": "Sign in", "href": "https://my.privatepracticeos.app" }
  },
  "contextual": { "options": ["copy", "view", "chatgpt", "claude"] },
  "footer": { "socials": {} },
  "redirects": [
    { "source": "/start-here/welcome", "destination": "/" },
    { "source": "/start-here/first-30-minutes", "destination": "/start-here/onboarding" },
    { "source": "/integrations/google-calendar", "destination": "/integrations/email" },
    { "source": "/integrations/google-workspace", "destination": "/integrations/email" },
    { "source": "/integrations/choose-calendars", "destination": "/calendar/availability" },
    { "source": "/integrations/conflict-calendars", "destination": "/calendar/availability" },
    { "source": "/calendar/conflict-calendars", "destination": "/calendar/availability" }
  ]
}
