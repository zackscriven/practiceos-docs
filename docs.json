{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PracticeOS Docs",
  "description": "Getting-started guides for PracticeOS: the Growth System and the Content Engine.",
  "colors": {
    "primary": "#554861",
    "light": "#A78BC8",
    "dark": "#3A3044"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#1C1523"
    }
  },
  "fonts": {
    "heading": {
      "family": "Playfair Display"
    },
    "body": {
      "family": "Nunito"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Growth System",
        "pages": [
          "growth-system/quickstart",
          "growth-system/onboarding-call",
          "growth-system/account-setup",
          "growth-system/email-calendar",
          "growth-system/social-accounts",
          "growth-system/website",
          "growth-system/calls-community"
        ]
      },
      {
        "group": "Content Engine",
        "pages": [
          "content-engine/quickstart",
          "content-engine/prepare-for-your-session",
          "content-engine/after-your-session"
        ]
      },
      {
        "group": "Whop",
        "pages": [
          "whop/membership",
          "whop/sell-on-whop"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "support"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open PracticeOS",
      "href": "https://my.privatepracticeos.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp"
    ]
  },
  "redirects": [
    {
      "source": "/start-here/:slug*",
      "destination": "/"
    },
    {
      "source": "/setup/:slug*",
      "destination": "/growth-system/account-setup"
    },
    {
      "source": "/integrations/google-business-profile",
      "destination": "/growth-system/social-accounts"
    },
    {
      "source": "/integrations/meta-facebook",
      "destination": "/growth-system/social-accounts"
    },
    {
      "source": "/integrations/:slug*",
      "destination": "/growth-system/email-calendar"
    },
    {
      "source": "/calendar/:slug*",
      "destination": "/growth-system/email-calendar"
    },
    {
      "source": "/website-growth/:slug*",
      "destination": "/growth-system/website"
    },
    {
      "source": "/troubleshooting/:slug*",
      "destination": "/support"
    },
    {
      "source": "/administration/:slug*",
      "destination": "/growth-system/account-setup"
    },
    {
      "source": "/ai/:slug*",
      "destination": "/"
    },
    {
      "source": "/using-practiceos/:slug*",
      "destination": "/"
    },
    {
      "source": "/inquiries/:slug*",
      "destination": "/"
    },
    {
      "source": "/communications/:slug*",
      "destination": "/"
    },
    {
      "source": "/automations/:slug*",
      "destination": "/"
    },
    {
      "source": "/privacy-security/:slug*",
      "destination": "/support"
    },
    {
      "source": "/reference/:slug*",
      "destination": "/"
    },
    {
      "source": "/release-notes",
      "destination": "/"
    }
  ],
  "footer": {
    "links": [
      {
        "header": "PracticeOS",
        "items": [
          {
            "label": "Sign in",
            "href": "https://my.privatepracticeos.app"
          },
          {
            "label": "privatepracticeos.app",
            "href": "https://privatepracticeos.app"
          }
        ]
      }
    ]
  }
}