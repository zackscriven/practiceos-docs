      "destination": "/using-practiceos/inbox"
    },
    {
      "source": "/inquiries/how-inquiries-enter",
      "destination": "/using-practiceos/inquiries"
    },
    {
      "source": "/inquiries/inquiry-stages",
      "destination": "/using-practiceos/inquiries"
    },
    {
      "source": "/inquiries/follow-up",
      "destination": "/using-practiceos/inquiries"
    },
    {
      "source": "/calendar/booking-pages",
      "destination": "/using-practiceos/calendar"
    },
    {
      "source": "/calendar/appointment-types",
      "destination": "/using-practiceos/calendar"
    }
  ]
